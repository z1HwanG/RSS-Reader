{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RSSReader",
  "version": "0.2.0",
  "identifier": "com.rssreader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RSS Reader",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#f3f3f3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost rssimg: http://rssimg.localhost data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMDE3MkRBN0RFRTQ2RjUKUldUMVJ1NTkybklCblNsNUUvWDBiM3hGMHZZRi9ScWJKdzFMNjQvd0dNYkhxWkU3MWJQd3BYUVEK",
      "endpoints": [
        "https://github.com/z1HwanG/RSS-Reader/releases/latest/download/latest.json",
        "https://git.z1hwang.cn/Zeehow/RSS-Reader/releases/download/latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}